[Unit]
Description=Meadow Market — Discord coin-bot + rol-toggle site (Rust)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=market
Group=market
WorkingDirectory=/opt/market
Environment=RUST_LOG=info,serenity=warn,tracing=warn
# Publieke basis-URL voor de OAuth2 redirect-URI (HTTPS via Caddy).
Environment=MARKET_BASE_URL=https://magicmeadow.org
# Shop-toegangsrol (Flowerborn) — overschrijft role_id uit secrets.json.
Environment=DISCORD_ROLE_ID=1525249217897955590
ExecStart=/opt/market/market
Restart=always
RestartSec=10
# Veiligheidscap: kan de Hytale-server nooit de OOM in duwen.
MemoryMax=250M
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
