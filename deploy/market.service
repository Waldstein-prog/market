[Unit]
Description=Meadow Market — Discord coin-bot + rol-toggle site (Rust)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=market
Group=market
WorkingDirectory=/opt/market
Environment=RUST_LOG=info,serenity=warn,tracing=warn
# Publieke basis-URL voor de OAuth2 redirect-URI (HTTPS via Caddy).
Environment=MARKET_BASE_URL=https://magicmeadow.org
# Guild + shop-toegangsrol (Flowerborn), allebei expliciet — overschrijft secrets.json.
#
# ⚠️ Stond tot 2026-07-15 op 1525249217897955590: dat is de Flowerborn van de DEV-guild
# (WaldsteinDevZone), een overblijfsel uit de dev-fase. Die rol bestáát niet in Magic
# Meadow, dus `has_role` gaf voor élk prod-lid false → iedereen zakte door de rolcheck en
# zag de regels-pagina i.p.v. de shop. Beide guilds hebben een rol "Flowerborn" met een
# ándere ID; hetzelfde geldt voor de kleurrollen (Amber, Ruby, …). Die laatste worden
# op **naam** opgezocht (`role_id_by_name`), dus die volgen de guild vanzelf — enkel deze
# twee ID's moeten kloppen.
Environment=DISCORD_GUILD_ID=1296469405651435592
Environment=DISCORD_ROLE_ID=1399336425069219881
ExecStart=/opt/market/market
Restart=always
RestartSec=10
# Veiligheidscap: kan de Hytale-server nooit de OOM in duwen.
MemoryMax=250M
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
